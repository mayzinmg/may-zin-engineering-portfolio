---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Projects | May Zin";
const description =
  "Completed projects, ongoing research and engineering experiments by May Zin.";

const projects = [
  {
    title: "Token Risk Intelligence Lakehouse",
    status: "Near Completion",
    area: "Data Engineering",
    summary:
      "A lakehouse project exploring reliable blockchain-data ingestion, validation, governance and risk analysis."
  },
  {
    title: "Talos Agent Lab",
    status: "Ongoing Series",
    area: "Agentic AI",
    summary:
      "A learning series investigating agent design, tool calling, permissions, tracing and responsible AI guardrails."
  },
  {
    title: "Job Application Copilot",
    status: "In Development",
    area: "Agentic AI",
    summary:
      "A human-in-the-loop assistant designed to support structured job evaluation, application tracking and preparation."
  },
  {
    title: "Engineering Portfolio",
    status: "Building in Public",
    area: "AI-Assisted Development",
    summary:
      "A portfolio developed through controlled vibe coding, documented decisions and continuous human review."
  }
];
---

<BaseLayout title={pageTitle} description={description}>
  <header class="page-heading">
    <p class="eyebrow">PROJECT INDEX</p>
    <h1>Engineering projects</h1>
    <p>
      A collection of completed systems, ongoing research and experiments
      documenting both engineering decisions and lessons learned.
    </p>
  </header>

  <section aria-labelledby="current-work-heading">
    <h2 id="current-work-heading">Current work</h2>

    <div class="project-grid">
      {
        projects.map((project) => (
          <article class="project-card">
            <p class="status">{project.status}</p>
            <h3>{project.title}</h3>
            <p>{project.summary}</p>
            <p class="area">{project.area}</p>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page-heading {
    margin-bottom: 4rem;
  }

  .eyebrow,
  .status,
  .area {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.875rem;
  }

  .eyebrow,
  .status {
    color: var(--colour-primary);
  }

  .eyebrow {
    margin-bottom: 1rem;
    letter-spacing: 0.08em;
  }

  h2 {
    margin-bottom: 1.5rem;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1rem;
  }

  .project-card {
    padding: 1.5rem;
    border: 1px solid var(--colour-border);
    border-radius: 0.75rem;
    background: var(--colour-surface);
  }

  .project-card h3 {
    margin-bottom: 0.75rem;
  }

  .status {
    margin-bottom: 0.75rem;
    font-weight: 600;
  }

  .area {
    margin-bottom: 0;
    color: var(--colour-text);
  }
</style>